---
import Head from "@components/Head.astro";
import DocsSidebar from "@components/DocsSidebar.astro";
import { SITE } from "@consts";
import { getCollection } from "astro:content";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
const demos = (await getCollection("demos")).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const onDemos = currentPath.startsWith("/demos");
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="lab-shell">
      <header class="lab-topbar">
        <div class="lab-container">
          <button
            type="button"
            id="rail-toggle"
            class="icon-button rail-toggle"
            aria-controls="lab-rail"
            aria-expanded="false"
            aria-label="Open navigation"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
          </button>
          <a class="lab-wordmark" href="/">{SITE.WORDMARK}</a>
          <nav class="lab-topnav" aria-label="Sections">
            <a href="/" class={currentPath === "/" ? "is-active" : undefined}>Overview</a>
            <a href="/demos" class={onDemos ? "is-active" : undefined}>Experiments</a>
            <a href={SITE.SOURCE} rel="noopener noreferrer" target="_blank">Source</a>
          </nav>
        </div>
      </header>

      <div id="rail-backdrop" class="rail-backdrop"></div>

      <div class="lab-body">
        <DocsSidebar demos={demos} currentPath={currentPath} />
        <main id="content">
          <slot />
        </main>
        <aside class="lab-meta" aria-label="Model metadata">
          <slot name="meta" />
        </aside>
      </div>

      <footer class="lab-footer">
        <span class="eyebrow">Field notes on local Hugging Face models</span>
        <span class="eyebrow">
          <a href={SITE.SOURCE} rel="noopener noreferrer" target="_blank">GitHub</a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href="#content" id="back-to-top">Back to top</a>
        </span>
      </footer>
    </div>
    <script>
      const shell = document.querySelector(".lab-shell");
      const toggle = document.getElementById("rail-toggle");
      const backdrop = document.getElementById("rail-backdrop");
      const rail = document.getElementById("lab-rail");

      function setOpen(open: boolean) {
        shell?.classList.toggle("rail-open", open);
        toggle?.setAttribute("aria-expanded", String(open));
        toggle?.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
      }

      toggle?.addEventListener("click", () => {
        setOpen(!shell?.classList.contains("rail-open"));
      });
      backdrop?.addEventListener("click", () => setOpen(false));
      rail?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setOpen(false);
      });
    </script>
  </body>
</html>
