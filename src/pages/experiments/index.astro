---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import LibraryMeta from "@components/LibraryMeta.astro";

const demos = (await getCollection("experiments")).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Experiments"
  description="Hugging Face models running entirely in your browser."
>
  <article class="docs-article">
    <h1>Experiments</h1>
    <p class="lead">
      Three interaction shapes: typed text, an uploaded image, and labels you
      invent at runtime. Each page loads its model only after you ask.
    </p>
    <ul class="demo-index">
      {demos.map((entry) => (
        <li>
          <a href={`/experiments/${entry.id}`}>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  </article>

  <Fragment slot="meta">
    <LibraryMeta demos={demos} />
  </Fragment>
</PageLayout>
