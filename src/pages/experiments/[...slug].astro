---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import DemoIsland from "@components/DemoIsland.astro";
import CodeTabs from "@components/demo-kit/CodeTabs.astro";
import { ModelCacheStatus } from "@components/demo-kit/ModelCacheStatus";

export async function getStaticPaths() {
  const demos = await getCollection("experiments");
  return demos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, task, model, sizeLabel, category } = entry.data;

/** Every figure here is read off the model we actually ship, never invented. */
const specs = [
  { label: "Reference", value: model.split("/").pop() ?? model },
  { label: "Footprint", value: sizeLabel.replace(/^~/, "") },
  { label: "Pipeline", value: task },
  { label: "Runtime", value: "WebGPU / WASM" },
];
---

<PageLayout title={title} description={summary}>
  <article class="docs-article">
    <ol class="breadcrumb eyebrow">
      <li><a href="/experiments">Experiments</a></li>
      <li>{category}</li>
      <li>{entry.id}</li>
    </ol>

    <h1>{title}</h1>
    <p class="lead">{summary}</p>

    <div class="spec-strip">
      {specs.map((spec) => (
        <div>
          <span class="eyebrow">{spec.label}</span>
          <span class="spec-value">{spec.value}</span>
        </div>
      ))}
    </div>

    <DemoIsland task={task} model={model} sizeLabel={sizeLabel} />

    <Content components={{ CodeTabs }} />
  </article>

  <Fragment slot="meta">
    <p class="eyebrow">Metadata</p>
    <div class="lab-meta-row">
      <span>Model</span>
      <span>{model}</span>
    </div>
    <div class="lab-meta-row">
      <span>Task</span>
      <span>{task}</span>
    </div>
    <div class="lab-meta-row">
      <span>Download</span>
      <span>{sizeLabel}</span>
    </div>
    <div class="lab-meta-rule"></div>
    <ModelCacheStatus client:load model={model} />
    <a
      class="eyebrow"
      href={`https://huggingface.co/${model}`}
      rel="noopener noreferrer"
      target="_blank"
    >
      View on Hugging Face →
    </a>
  </Fragment>
</PageLayout>
