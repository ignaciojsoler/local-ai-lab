---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const demos = (await getCollection("demos")).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <article class="docs-article">
    <h1>{SITE.NAME}</h1>
    <p class="lead">
      Hugging Face models that download into this tab and run on your machine.
      There is no inference API, no key, and no text or image leaves the browser.
    </p>

    <h2 id="how-it-runs">How it runs</h2>
    <p>
      Each page is a short write-up plus a working demo. The first click
      states the download size, then fetches quantized ONNX weights from the
      Hugging Face CDN and caches them in IndexedDB. Inference happens in a
      Web Worker: WebGPU when the browser can initialize it, WASM on CPU
      otherwise.
    </p>
    <p>
      Open a model on the left, load it once, and try the samples. The
      Python and JavaScript snippets at the bottom of each page show the same
      pipeline outside this site.
    </p>

    <h2 id="demos">Demos</h2>
    <ul class="demo-index">
      {demos.map((entry) => (
        <li>
          <a href={`/demos/${entry.id}`}>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>

    <h2 id="contact">Contact</h2>
    <p>
      {SOCIALS.map((social, index) => (
        <>
          {index > 0 && " · "}
          <a href={social.HREF}>{social.NAME}</a>
        </>
      ))}
      {" · "}
      <a href={`mailto:${SITE.EMAIL}`}>{SITE.EMAIL}</a>
    </p>
  </article>
</PageLayout>
