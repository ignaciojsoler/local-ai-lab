---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import DemoIsland from "@components/DemoIsland.astro";
import CodeTabs from "@components/demo-kit/CodeTabs.astro";

export async function getStaticPaths() {
  const demos = await getCollection("demos");
  return demos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.summary} headings={headings}>
  <article class="docs-article">
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.summary}</p>
    <p class="model-meta">
      <span>{entry.data.task}</span>
      <span>{entry.data.model}</span>
      <span>{entry.data.sizeLabel}</span>
    </p>

    <DemoIsland
      task={entry.data.task}
      model={entry.data.model}
      sizeLabel={entry.data.sizeLabel}
    />

    <Content components={{ CodeTabs }} />
  </article>
</PageLayout>
