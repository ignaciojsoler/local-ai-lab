---
import type { CollectionEntry } from "astro:content";
import { SITE } from "@consts";

type Props = {
  demos: CollectionEntry<"experiments">[];
  currentPath: string;
};

const { demos, currentPath } = Astro.props;

/** One sub-group per task family, in the order the demos are listed. */
const categories: Array<{ name: string; entries: CollectionEntry<"experiments">[] }> = [];
for (const entry of demos) {
  const group = categories.find((candidate) => candidate.name === entry.data.category);
  if (group) group.entries.push(entry);
  else categories.push({ name: entry.data.category, entries: [entry] });
}
---

<nav id="lab-rail" class="lab-rail" aria-label="Site">
  <div class="lab-rail-section is-first">
    <p class="eyebrow">Guide</p>
    <div class="lab-rail-group">
      <a href="/" class={currentPath === "/" ? "is-active" : undefined}>Overview</a>
      <a href={SITE.SOURCE} rel="noopener noreferrer" target="_blank">Source</a>
    </div>
  </div>

  <div class="lab-rail-section">
    <p class="eyebrow">Experiments</p>
    {categories.map((category) => (
      <div class="lab-rail-group">
        <p class="lab-rail-category">{category.name}</p>
        {category.entries.map((entry) => {
          const href = `/experiments/${entry.id}`;
          return (
            <a href={href} class={currentPath === href ? "is-active" : undefined}>
              {entry.data.title}
            </a>
          );
        })}
      </div>
    ))}
  </div>
</nav>
