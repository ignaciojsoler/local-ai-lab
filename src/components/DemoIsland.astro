---
import SentimentDemo from "@components/demos/SentimentDemo";
import ImageClassificationDemo from "@components/demos/ImageClassificationDemo";
import ZeroShotDemo from "@components/demos/ZeroShotDemo";
import SemanticSearchDemo from "@components/demos/SemanticSearchDemo";
import ObjectDetectionDemo from "@components/demos/ObjectDetectionDemo";
import TranslationDemo from "@components/demos/TranslationDemo";
import SpeechDemo from "@components/demos/SpeechDemo";

type Props = {
  task: string;
  model: string;
  sizeLabel: string;
};

const { task, model, sizeLabel } = Astro.props;
---

<section id="live-demo" class="demo-panel" aria-label="Live demo">
  {task === "text-classification" && (
    <SentimentDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "image-classification" && (
    <ImageClassificationDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "zero-shot-classification" && (
    <ZeroShotDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "feature-extraction" && (
    <SemanticSearchDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "object-detection" && (
    <ObjectDetectionDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "translation" && (
    <TranslationDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
  {task === "automatic-speech-recognition" && (
    <SpeechDemo client:load model={model} sizeLabel={sizeLabel} />
  )}
</section>
