{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/demos",
      "destination": "/experiments",
      "permanent": true
    },
    {
      "source": "/demos/:slug",
      "destination": "/experiments/:slug",
      "permanent": true
    }
  ]
}
